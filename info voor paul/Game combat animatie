using UnityEngine;
using UnityEngine.UI;
using System.Collections;

public class CombatEffects : MonoBehaviour
{
    public RectTransform daggerTransform; // Sleep de dolk hierheen
    public CanvasGroup bloodCanvasGroup; // Sleep de bloed-overlay hierheen
    public float animationSpeed = 5f;

    public void TriggerDaggerAttack()
    {
        StartCoroutine(PlayAttackAnimation());
    }

    private IEnumerator PlayAttackAnimation()
    {
        // 1. Reset posities
        daggerTransform.anchoredPosition = new Vector2(-1000, -500); // Start linksonder buiten beeld
        bloodCanvasGroup.alpha = 0;

        // 2. Dolk schiet door het scherm (Animeren naar rechtsboven)
        float elapsed = 0;
        Vector2 targetPos = new Vector2(1000, 500);
        Vector2 startPos = daggerTransform.anchoredPosition;

        while (elapsed < 0.5f)
        {
            daggerTransform.anchoredPosition = Vector2.Lerp(startPos, targetPos, elapsed * animationSpeed);
            elapsed += Time.deltaTime;
            yield return null;
        }

        // 3. Bloed spat op het scherm (Fade in)
        float bloodElapsed = 0;
        while (bloodElapsed < 0.2f)
        {
            bloodCanvasGroup.alpha = Mathf.Lerp(0, 1, bloodElapsed / 0.2f);
            bloodElapsed += Time.deltaTime;
            yield return null;
        }

        // 4. Wacht even en laat het bloed langzaam wegtrekken
        yield return new WaitForSeconds(1f);
        
        while (bloodCanvasGroup.alpha > 0)
        {
            bloodCanvasGroup.alpha -= Time.deltaTime;
            yield return null;
        }
    }
}




