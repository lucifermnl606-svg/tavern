2. De Logica: Iemand in een Zombie veranderen
Dit gebeurt via de doZombify functie. Let op: als je al een zombie bent, moet het doelwit eerst vergiftigd zijn om de Infection te laten slagen.

function execute(targetName) {
    // Speciale check voor de 'Infection' move van de Zombie zelf
    if (a.fx.toLowerCase() === 'zombify' && myData.class.toLowerCase() === "zombie") {
        db.ref('accounts/' + targetName).once('value', snap => {
            const targetData = snap.val();
            if (!targetData.FX || targetData.FX.toLowerCase() !== 'poison') { 
                alert("❌ Infectie mislukt: Het doelwit moet eerst VERGIFTIGD zijn!"); 
            } else { doZombify(targetName, targetData); finishAction(); }
        });
        return;
    }

    // Algemene zombify (voor Necro/Gravedigger)
    if (a.fx === 'zombify') {
        db.ref('accounts/' + targetName).once('value', snap => { doZombify(targetName, snap.val()); finishAction(); });
        return;
    }
}

function doZombify(tName, tData) {
    db.ref('accounts/' + tName).update({ 
        originalClass: tData.class,   // Onthoudt wat je was
        preZombieHP: tData.hp,        // Onthoudt je oude HP
        class: 'Zombie', 
        zombieTimer: 3,               // Je bent 3 beurten een zombie
        hp: 20000,                    // Tijdelijk extreem veel HP
        pendingFX: null, 
        sleepTimer: 0 
    });
}

3. De Logica: Terugveranderen naar mens
Tijdens passTurn wordt de timer verlaagd. Als deze 0 bereikt, word je weer je oude class met je oude HP (min 30 schade).

JavaScript
if(npData.class === "Zombie") {
    let zt = (npData.zombieTimer || 1) - 1;
    if(zt <= 0) {
        let oldHP = npData.preZombieHP || 500;
        turnUpdates.class = npData.originalClass || "Wizard"; // Terug naar origineel
        turnUpdates.zombieTimer = 0;
        turnUpdates.hp = oldHP - 30; // Strafschade na genezing
        turnUpdates.preZombieHP = null;
        alert(nextPlayer.toUpperCase() + " is geen Zombie meer!");
    } else {
        turnUpdates.zombieTimer = zt;
    }
}
