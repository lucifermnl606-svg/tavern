<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tavern RPG - Alle Helden & Abilities</title>
    <style>
        :root {
            --gold: #f1c40f; --red: #e74c3c; --blue: #3498db; --green: #2ecc71; 
            --purple: #9b59b6; --bg: #050510; --card: #0a0a1a; --border: #1e3799;
        }
        body { font-family: 'Segoe UI', sans-serif; background: var(--bg); color: white; padding: 20px; }
        .container { max-width: 1100px; margin: 0 auto; }
        h1 { text-align: center; color: var(--gold); border-bottom: 2px solid var(--gold); padding-bottom: 10px; }
        
        .class-section { 
            background: var(--card); border: 2px solid var(--border); 
            border-radius: 15px; margin-bottom: 30px; overflow: hidden; 
        }
        .class-header { background: var(--border); padding: 10px 20px; color: var(--gold); font-size: 1.5rem; }
        
        .ability-grid { 
            display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); 
            gap: 10px; padding: 15px; 
        }
        .ability-card { 
            background: rgba(255,255,255,0.03); border: 1px solid #222; 
            padding: 10px; border-radius: 8px; font-size: 0.9rem;
        }
        .ability-name { color: var(--gold); font-weight: bold; display: block; }
        .ability-desc { color: #bbb; display: block; margin: 5px 0; min-height: 35px; }
        .ability-meta { 
            display: flex; justify-content: space-between; 
            font-size: 0.75rem; border-top: 1px solid #333; padding-top: 5px; 
        }
        .zombie-style { border-color: var(--green); }
        .zombie-style .class-header { background: #1a2310; }
    </style>
</head>
